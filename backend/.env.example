# This is a demo env file ot help users use this project locally in their systems 
PORT=3000
MONGO_URL=mongodb://localhost:27017/collabsuite
JWT_SECRET=your_jwt_secret_key_here_change_in_production
CLIENT_URL=http://localhost:5173

# Email Configuration (Gmail)
# To use Gmail, you need to:
# 1. Enable 2-factor authentication on your Google account
# 2. Generate an "App Password" from https://myaccount.google.com/apppasswor <--- important
# 3. Use that app password below (not your regular Gmail password)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password-here
